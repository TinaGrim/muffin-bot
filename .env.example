TELEGRAM_BOT_TOKEN=
# Optional: comma-separated Telegram user IDs. Empty = anyone who DMs the bot.
ALLOWED_USER_IDS=
# Optional: comma-separated group/channel IDs the bot may talk in.
ALLOWED_CHAT_IDS=

# Any OpenAI-compatible endpoint works: Ollama, LM Studio, OpenRouter, OpenAI...
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=120

# Persona retrieval
RETRIEVE_K=2
# If a past message matches this closely, reuse Muffin's real reply. 0 disables.
DIRECT_REPLY_THRESHOLD=0.9
HISTORY_MESSAGES=12
MAX_REPLY_CHARS=160

# Ignore messages older than this on startup (seconds). 0 disables.
MAX_MESSAGE_AGE_SECONDS=300

# Use the compact prompt for a local LoRA adapter.
ADAPTER_MODE=false

# If the main provider fails (rate limit/network), answer with this model.
FALLBACK_BASE_URL=http://localhost:11434/v1
FALLBACK_API_KEY=ollama
FALLBACK_MODEL=qwen2.5:3b-instruct

# Spontaneous messages when Bong is quiet.
PROACTIVE=true
PROACTIVE_MIN_HOURS=3
PROACTIVE_MAX_HOURS=6
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=8
DOUBLE_TEXT_CHANCE=0.25

# Chance to send one of Muffin's real stickers after a text reply.
STICKER_CHANCE=0.10

# Spontaneous texts: one every 1.5-3 hours, quiet 23:00-08:00.
PROACTIVE=true
PROACTIVE_MIN_HOURS=1.5
PROACTIVE_MAX_HOURS=3
PROACTIVE_QUIET_START=23
PROACTIVE_QUIET_END=8
